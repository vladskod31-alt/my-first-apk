<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#9D7BFF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#191920</item>
        <item name="android:navigationBarColor">#191920</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#191920</item>
        <item name="android:windowSplashScreenBackground">#4C1D95</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#4C1D95</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
    </style>
