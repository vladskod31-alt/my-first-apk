# Configure privately on your own server. Do not put actual credentials in Git or chat.
PORT=3000
ACCOUNT_DB=.local/accounts.sqlite
ALLOWED_ORIGINS=https://appassets.androidplatform.net
TRUST_PROXY=0
MAX_SMS_PER_DAY=25
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional public HTTPS URL to embed in an APK. No credentials here.
VITE_ACCOUNT_SERVER=

# LIBO 2.3 cloud relay. Configure a persistent private volume on your server.
CLOUD_DB=.local/cloud.sqlite
CLOUD_QUOTA_BYTES=67108864
CLOUD_TOTAL_QUOTA_BYTES=536870912
CLOUD_MAX_ACCOUNTS=100
# Used by server/compose.yaml; set your own DNS name before deployment.
LIBO_DOMAIN=
# Optional public HTTPS endpoint, never an API key or password.
VITE_CLOUD_URL=
