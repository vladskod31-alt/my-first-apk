# Replace this with the public RSS/Atom feed or materials page you want to monitor.
DBA_SOURCE_URL=https://example.org/feed.xml
# auto detects RSS/Atom vs HTML. Set explicitly to feed or html if detection is wrong.
DBA_MODE=auto

# Optional delivery: leave both unset to print notifications to the console.
# Generic JSON webhook:
# DBA_NOTIFY_WEBHOOK_URL=https://example.org/notify
# Or Telegram (set both values; do not commit real credentials):
# DBA_TELEGRAM_BOT_TOKEN=replace-me
# DBA_TELEGRAM_CHAT_ID=replace-me

# On the first run, current entries are saved as a baseline and not sent.
DBA_NOTIFY_EXISTING=false
DBA_STATE_FILE=data/seen.json
DBA_INTERVAL_SECONDS=900
DBA_HTTP_TIMEOUT=20

# For HTML pages, adjust these CSS selectors to match the page's markup.
DBA_ITEM_SELECTOR=article
DBA_TITLE_SELECTOR=h1, h2, h3, h4
DBA_LINK_SELECTOR=a[href]
DBA_DATE_SELECTOR=time[datetime], [datetime]
